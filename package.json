{
  "name": "nibo-scraper",
  "version": "1.0.0",
  "description": "Scraper Playwright pra baixar folhas de pagamento do Nibo (MDCGT)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "backfill": "node --env-file=.env scripts/backfill.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "1.60.0",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  }
}
