# ============ Credenciais Nibo ============
# E-mail e senha do usuário do Nibo.
NIBO_EMAIL=fernando.jamel@maniadechurrasco.com
NIBO_PASSWORD=trocar_pela_senha_real

# Secret TOTP do app autenticador (formato base32, sem espaços).
# Esse é o "secret" que o 2FAS / Google Authenticator gera junto com o QR.
NIBO_TOTP_SECRET=JBSWY3DPEHPK3PXP

# ============ Token de autenticação do scraper ============
# Token compartilhado entre n8n e este scraper (gere com `openssl rand -hex 32`).
# O n8n envia esse token no header X-Scraper-Token; o scraper rejeita requisições sem ele.
SCRAPER_TOKEN=gere_um_token_aleatorio_de_64_caracteres

# ============ Configuração ============
# Quantas tentativas o scraper faz se algo falhar (login, listagem, download)
RETRY_ATTEMPTS=3

# Timeout do Playwright em ms (60s pra navegação, 15s pra elementos)
NAV_TIMEOUT_MS=60000
WAIT_TIMEOUT_MS=15000

# Roda o Chromium sem interface (true em produção; false em dev pra ver o que está acontecendo)
HEADLESS=true

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# ============ Supabase (usado pelo script backfill e por testes manuais) ============
# Mesma URL que está no .env do app Flutter.
SUPABASE_URL=https://kwziwfzkxuekwicfcscw.supabase.co

# Service role key — bypassa RLS, NUNCA exposta ao cliente Flutter.
# Pega em Supabase Dashboard → Project Settings → API → Project API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
